{
  "name": "marcia-confeitaria-backend",
  "version": "1.0.0",
  "description": "API de gestao de pedidos e producao para Marcia Atelier de Bolos & Macarons",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/utils/runSql.js",
    "create-admin": "node src/utils/createAdmin.js",
    "test-data": "node src/utils/seedTestData.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "change-password": "node src/utils/changePassword.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.3.2"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/utils/runSql.js",
      "!src/utils/createAdmin.js",
      "!src/utils/seedTestData.js",
      "!src/utils/changePassword.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 75
      }
    }
  }
}
